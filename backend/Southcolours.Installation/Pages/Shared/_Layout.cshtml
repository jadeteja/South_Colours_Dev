<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - South Colours SQL Server Installation Wizard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #f04e79;
            --primary-gradient: linear-gradient(135deg, #f04e79 0%, #ff7e5f 100%);
            --dark: #0f172a;
            --gray-text: #64748b;
            --card-bg: #ffffff;
            --body-bg: #fdf4f6;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: linear-gradient(135deg, #fff5f7 0%, #fdf2f8 40%, #f8fafc 100%);
            min-height: 100vh;
            color: #1e293b;
            display: flex;
            flex-direction: column;
        }

        /* Top Navigation Header */
        .wizard-header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(240, 78, 121, 0.15);
            padding: 16px 32px;
            box-shadow: 0 4px 20px -2px rgba(240, 78, 121, 0.08);
        }

        .header-container {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-logo {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-weight: 800;
            font-size: 1.25rem;
            box-shadow: 0 6px 14px rgba(240, 78, 121, 0.35);
        }

        .brand-title {
            font-size: 1.35rem;
            font-weight: 800;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
        }

        .brand-subtitle {
            font-size: 0.85rem;
            color: var(--gray-text);
            font-weight: 500;
        }

        .mode-badge {
            background: #fff1f2;
            color: #e11d48;
            border: 1px solid #fecdd3;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .mode-badge::before {
            content: "";
            width: 8px;
            height: 8px;
            background: #e11d48;
            border-radius: 50%;
        }

        /* Stepper */
        .wizard-stepper {
            max-width: 820px;
            margin: 36px auto 0 auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
            font-weight: 600;
            color: #94a3b8;
        }

        .step-num {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .step-item.active {
            color: #f04e79;
        }

        .step-item.active .step-num {
            background: var(--primary-gradient);
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(240, 78, 121, 0.35);
        }

        .step-separator {
            flex: 1;
            height: 2px;
            background: #e2e8f0;
            margin: 0 16px;
            border-radius: 2px;
        }

        /* Card Content Container */
        .wizard-content {
            max-width: 820px;
            width: 100%;
            margin: 28px auto 40px auto;
            background: #ffffff;
            padding: 44px 50px;
            border-radius: 24px;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.05), 0 4px 16px -2px rgba(240, 78, 121, 0.04);
            border: 1px solid rgba(240, 78, 121, 0.12);
        }

        h2 {
            font-size: 1.65rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .subtitle {
            color: var(--gray-text);
            font-size: 0.95rem;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
            font-size: 0.9rem;
            color: #334155;
        }

        .form-control {
            width: 100%;
            padding: 14px 18px;
            background: #f8fafc;
            border: 1.5px solid #cbd5e1;
            border-radius: 14px;
            font-size: 0.95rem;
            font-family: inherit;
            color: #0f172a;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            outline: none;
            background: #ffffff;
            border-color: #f04e79;
            box-shadow: 0 0 0 4px rgba(240, 78, 121, 0.15);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 13px 28px;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            border: none;
            text-decoration: none;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-primary {
            background: var(--primary-gradient);
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(240, 78, 121, 0.35);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(240, 78, 121, 0.45);
        }

        .btn-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(16, 185, 129, 0.45);
        }

        /* Alerts & Badges */
        .alert {
            padding: 18px 22px;
            border-radius: 14px;
            margin-bottom: 26px;
            font-size: 0.93rem;
            line-height: 1.6;
        }

        .alert-info {
            background: #fff1f2;
            border: 1.5px solid #fecdd3;
            color: #9f1239;
        }

        .alert-info h4 {
            color: #881337;
            margin-bottom: 8px;
            font-size: 1.05rem;
            font-weight: 700;
        }

        .alert-danger {
            background: #fef2f2;
            border: 1.5px solid #fecaca;
            color: #991b1b;
        }

        .alert-warning {
            background: #fffbeb;
            border: 1.5px solid #fde68a;
            color: #92400e;
        }

        .wizard-footer {
            text-align: center;
            color: #94a3b8;
            font-size: 0.85rem;
            padding: 24px;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header class="wizard-header">
        <div class="header-container">
            <div class="brand">
                <div class="brand-logo">SC</div>
                <div>
                    <div class="brand-title">South Colours</div>
                    <div class="brand-subtitle">Database Installation Wizard (SQL Server)</div>
                </div>
            </div>
            <div class="mode-badge">Operator Console</div>
        </div>
    </header>

    <div class="wizard-stepper">
        <div class="step-item @(ViewData["Step"]?.ToString() == "1" ? "active" : "")">
            <span class="step-num">1</span> Connection
        </div>
        <div class="step-separator"></div>
        <div class="step-item @(ViewData["Step"]?.ToString() == "2" ? "active" : "")">
            <span class="step-num">2</span> Review
        </div>
        <div class="step-separator"></div>
        <div class="step-item @(ViewData["Step"]?.ToString() == "3" ? "active" : "")">
            <span class="step-num">3</span> Install
        </div>
        <div class="step-separator"></div>
        <div class="step-item @(ViewData["Step"]?.ToString() == "4" ? "active" : "")">
            <span class="step-num">4</span> Complete
        </div>
    </div>

    <main class="wizard-content">
        @RenderBody()
    </main>

    <footer class="wizard-footer">
        South Colours Operator Console &bull; Private &amp; Restricted Deployment Runner
    </footer>
</body>
</html>
